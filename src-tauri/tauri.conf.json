{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My Doc",
  "version": "0.1.0",
  "identifier": "com.doerwise.mydoc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "My Doc",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/file-menu.nsh"
      }
    },
    "publisher": "Doerwise",
    "category": "Productivity",
    "shortDescription": "One place for every document. Markdown at its core.",
    "homepage": "https://mydocs.doerwise.com/",
    "fileAssociations": [
      {
        "name": "MyDocs documents",
        "description": "Document opened with MyDocs",
        "ext": [
          "md",
          "markdown",
          "mdx",
          "mdown",
          "mkd",
          "txt",
          "text",
          "log",
          "docx",
          "xlsx",
          "csv",
          "tsv",
          "tab",
          "unl",
          "html",
          "htm",
          "pdf",
          "json",
          "yaml",
          "yml",
          "xml",
          "toml",
          "ini",
          "env",
          "js",
          "ts",
          "jsx",
          "tsx",
          "css",
          "py",
          "sql",
          "sh",
          "rs",
          "c",
          "cpp",
          "h",
          "cs",
          "java",
          "go",
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "svg",
          "avif",
          "bmp",
          "ico",
          "mp3",
          "wav",
          "ogg",
          "oga",
          "opus",
          "flac",
          "m4a",
          "aac",
          "mp4",
          "m4v",
          "webm",
          "ogv",
          "mov",
          "mkv",
          "avi",
          "zip",
          "pptx",
          "odt",
          "ods",
          "odp",
          "rtf",
          "doc",
          "xls",
          "ppt"
        ],
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MTFCQTExRjY3OTJDRUEKUldUcUxIbjJFYm9SdHlOeGhudzZhTVBrODlIMHNRaUZjRm5lejBxTDY4NlRnUVZzUW1nSStEVncK",
      "endpoints": ["https://github.com/adan35/my-doc/releases/latest/download/latest.json"]
    }
  }
}
